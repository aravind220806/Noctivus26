# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
ENVIRONMENT=development
WEB_CONCURRENCY=2
REDIS_URL=
ENABLE_UNPREFIXED_ROUTES=false
PUBLIC_SELF_CHECKIN_ENABLED=false
INVITATION_SEND_CONCURRENCY=2

# ── Database ──────────────────────────────────────────────────────────────────
# Leave blank for dev (defaults to backend/noctivus.db).
# Docker sets this to /data/noctivus.db via compose environment override.
SQLITE_DB_PATH=
ALLOW_MEMORY_DB=false

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SESSION_SECRET=replace-with-long-random-secret

# Google OAuth — client ID from Google Cloud Console
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Comma-separated list of Google accounts allowed to access the admin panel
ADMIN_EMAILS=admin@example.com,coordinator@example.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of exact frontend origins (no trailing slash)
FRONTEND_ORIGINS=https://noctivus26.vercel.app

# ── Registration ──────────────────────────────────────────────────────────────
REGISTRATION_OPEN=false

# Optional per-event capacity caps e.g. ideathon:100,cyber-heist-ctf:80
EVENT_CAPACITIES=

# ── Email ─────────────────────────────────────────────────────────────────────
# Use either Resend (preferred) or SMTP — Resend takes priority if key is set
RESEND_API_KEY=
CONFIRM_FROM=Noctivus 26 <registrations@noctivus26.com>

# SMTP fallback (used only if RESEND_API_KEY is empty)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=noctivus2026@gmail.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noctivus2026@gmail.com

# ── Google Sheets live mirror ─────────────────────────────────────────────────
GOOGLE_SHEETS_LIVE_SYNC_ENABLED=true
GOOGLE_SHEETS_SPREADSHEET_ID=
# Paste the full service account JSON as a single line (base64 or raw)
GOOGLE_SERVICE_ACCOUNT_JSON=
