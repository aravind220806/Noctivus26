PORT=4000
ENVIRONMENT=development
MONGODB_URI=
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2
MONGODB_SERVER_SELECTION_TIMEOUT_MS=8000
WEB_CONCURRENCY=2
REDIS_URL=
ENABLE_UNPREFIXED_ROUTES=false
PUBLIC_SELF_CHECKIN_ENABLED=false


# Optional comma-separated limits, for example: ideathon:100,cyber-heist-ctf:100
EVENT_CAPACITIES=


# Optional alternative path. By default the server also checks ../atlas-credentials.env.
ATLAS_CREDENTIALS_FILE=
FRONTEND_ORIGINS=http://localhost:5173
ADMIN_SESSION_SECRET=replace-with-another-long-random-secret
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
ADMIN_EMAILS=admin1@example.com,admin2@example.com


# Local development only. Production startup fails if this is true.
ALLOW_MEMORY_DB=true
REGISTRATION_OPEN=true
RESEND_API_KEY=
CONFIRM_FROM=Noctivus 26 <registrations@example.com>
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SHEETS_SPREADSHEET_ID=
