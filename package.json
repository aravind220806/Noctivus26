{
  "name": "noctivus26",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"blue,magenta\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node scripts/run-backend.js run.py",
    "dev:web": "npm run dev --workspace frontend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "node scripts/run-backend.js run.py",
    "test": "node scripts/run-backend.js -m compileall app run.py"
  },
  "dependencies": {
    "lucide-react": "^1.39.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
