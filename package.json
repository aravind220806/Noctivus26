{
  "name": "noctivus26",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"blue,magenta\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd backend && (python run.py || python3 run.py || .venv\\Scripts\\python.exe run.py)",
    "dev:web": "npm run dev --workspace frontend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "cd backend && (python run.py || python3 run.py || .venv\\Scripts\\python.exe run.py)",
    "test": "cd backend && pytest"
  },
  "dependencies": {
    "lucide-react": "^1.37.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
